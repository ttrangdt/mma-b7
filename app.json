{
  "expo": {
    "name": "AI Photo Memories",
    "slug": "ai-photo-memories",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500&auto=format&fit=crop&q=80",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500&auto=format&fit=crop&q=80",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần sử dụng máy ảnh để chụp ảnh và ghi lại kỷ niệm.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập thư viện ảnh để phân tích và xem lại kỷ niệm.",
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần truy cập vị trí để ghim vị trí chụp ảnh lên Google Maps."
      }
    },
    "android": {
      "package": "com.mma301.aiphotomemories",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500&auto=format&fit=crop&q=80",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=128&auto=format&fit=crop&q=80"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ứng dụng chọn ảnh từ thư viện.",
          "cameraPermission": "Cho phép ứng dụng chụp ảnh bằng camera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cho phép ứng dụng lấy vị trí khi chụp ảnh để hiển thị lên bản đồ."
        }
      ]
    ]
  }
}
